# OpenRouter API key (for LLM question generation)
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model (optional, defaults to openai/gpt-3.5-turbo)
# List of models: https://openrouter.ai/docs#models
# Examples:
#   openai/gpt-3.5-turbo (faster, cheaper)
#   openai/gpt-4-turbo (slower, better quality)
#   anthropic/claude-3-sonnet (balanced)
#   meta-llama/llama-2-70b (open source)
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Next.js (optional, auto-detected)
NEXT_PUBLIC_APP_URL=http://localhost:3000
